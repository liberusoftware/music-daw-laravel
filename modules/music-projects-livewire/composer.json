{
  "name": "liberusoftware/music-projects-livewire",
  "description": "Music session workspace, track metadata, checkpoints, recovery and reviewed portable imports.",
  "type": "liberu-module",
  "license": "MIT",
  "version": "0.1.0",
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/liberusoftware/module-music-projects"
    }
  ],
  "require": {
    "php": "^8.5",
    "php-64bit": "^8.5",
    "livewire/livewire": "^4.4",
    "illuminate/support": "^13.38",
    "illuminate/routing": "^13.38",
    "illuminate/validation": "^13.38",
    "liberusoftware/music-projects": "^0.1 || dev-main"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Music\\ProjectsLivewire\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Music\\ProjectsLivewire\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.8",
    "pestphp/pest": "^5.3"
  },
  "extra": {
    "liberu": {
      "name": "music-projects-livewire"
    },
    "laravel": {
      "providers": []
    }
  },
  "scripts": {
    "test": "pest",
    "test:coverage": "pest --coverage --min=100"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "github-protocols": [
      "https"
    ]
  }
}
