{
  "openapi": "3.1.0",
  "info": {
    "title": "Music Media Library API",
    "version": "0.1.0",
    "description": "Initial read and waveform-task contract. Abilities: music.media.read for queries, music.media.process plus read for task mutation, music.media.quota.read for budgets. Binary transfer, upload verification, edits, packs and lifecycle HTTP operations are explicitly unsupported in this increment. No native audio/device execution.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "The current host; the module is disabled unless explicitly enabled."
    }
  ],
  "tags": [
    {
      "name": "Media",
      "description": "Authorized verified assets and owned waveform jobs."
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
