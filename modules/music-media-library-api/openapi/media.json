                },
                "code": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Audio": {
        "type": "object",
        "required": [
          "sha256",
          "bytes",
          "sample_rate",
          "channels",
          "frames"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 44,
            "description": "Verified WAVE object bytes."
          },
          "sample_rate": {
            "type": "integer",
            "minimum": 1,
            "description": "Sample frames per second (Hz)."
          },
          "channels": {
            "type": "integer",
            "minimum": 1
          },
          "frames": {
            "type": "integer",
            "minimum": 1,
            "description": "Total sample frames."
          }
        }
      },
      "Asset": {
        "type": "object",
        "required": [
          "id",
          "workspace_id",
          "name",
          "audio",
          "provenance",
          "duplicate_of"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspace_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "audio": {
            "$ref": "#/components/schemas/Audio"
          },
          "provenance": {
            "type": "object"
          },
          "duplicate_of": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "available": {
            "type": "boolean"
          }
        }
      },
      "Task": {
        "type": "object",
        "required": [
          "schema_version",
          "id",
          "workspace_id",
          "asset_id",
          "requested_sample_frames_per_peak",
          "status",
          "terminal",
          "cancellable",
          "progress"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspace_id": {
            "type": "string"
          },
          "asset_id": {
            "type": "string",
            "format": "uuid"
          },
          "requested_sample_frames_per_peak": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "ready",
              "failed",
              "cancelled"
            ]
          },
          "terminal": {
            "type": "boolean"
          },
          "cancellable": {
            "type": "boolean"
          },
          "progress": {
            "type": "object",
            "required": [
              "completed_steps",
              "total_steps",
              "unit"
            ],
            "properties": {
              "completed_steps": {
                "type": "integer",
                "enum": [
                  0,
                  1
                ]
              },
              "total_steps": {
                "type": "integer",
                "const": 1
              },
              "unit": {
                "type": "string",
                "const": "waveform_build"
              }
            }
          }
        }
      },
      "Waveform": {
        "type": "object",
        "required": [
          "schema_version",
          "source_sha256",
          "sample_rate",
          "channels",
          "sample_frames",
          "sample_frames_per_peak",
          "peaks"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sample_rate": {
            "type": "integer"
          },
          "channels": {
            "type": "integer"
          },
          "channel_mask": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sample_frames": {
            "type": "integer"
          },
          "sample_frames_per_peak": {
            "type": "integer"
          },
          "peaks": {
            "type": "array",
            "maxItems": 16384,
            "items": {
              "type": "object",
              "required": [
                "start_sample_frame",
                "end_sample_frame",
                "channels"
              ],
              "properties": {
                "start_sample_frame": {
                  "type": "integer"
                },
                "end_sample_frame": {
                  "type": "integer"
                },
                "channels": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "minimum",
                      "maximum"
                    ],
                    "properties": {
                      "minimum": {
                        "type": "number"
                      },
                      "maximum": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Budget": {
        "type": "object",
        "required": [
          "schema_version",
          "workspace_id",
          "reserved_bytes",
          "limit_bytes",
          "available_bytes",
          "over_limit",
          "reservation_multiplier"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "workspace_id": {
            "type": "string"
          },
          "reserved_bytes": {
            "type": "integer"
          },
          "limit_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "available_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "over_limit": {
            "type": "boolean"
          },
          "reservation_multiplier": {
            "type": "integer",
            "const": 2
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "schema_version",
          "operations",
          "unsupported"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unsupported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Problem response with status, structured errors and correlation ID; private implementation details are redacted.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
