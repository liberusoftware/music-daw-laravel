  "components": {
    "securitySchemes": {
      "sanctum": {
        "type": "http",
        "scheme": "bearer",
        "description": "Host-issued Sanctum token; required abilities are listed per operation. Session requests need host-configured stateful Sanctum and CSRF handling."
      }
    },
    "schemas": {
      "SessionDocument": {
        "type": "object",
        "required": [
          "schema_version",
          "engine_version",
          "sample_rate",
          "tracks",
          "assets",
          "modules"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "engine_version": {
            "type": "string"
          },
          "sample_rate": {
            "type": "integer",
            "minimum": 8000,
            "maximum": 384000
          },
          "tracks": {
            "type": "array",
            "maxItems": 2048,
            "items": {
              "$ref": "#/components/schemas/Track"
            }
          },
          "assets": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "$ref": "#/components/schemas/AssetReference"
            }
          },
          "modules": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/ModuleState"
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ModuleState"
                }
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "SessionRevision": {
        "type": "object",
        "required": [
          "workspace_id",
          "project_id",
          "title",
          "version",
          "document",
          "autosave",
          "template"
        ],
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "document": {
            "$ref": "#/components/schemas/SessionDocument"
          },
          "autosave": {
            "type": "boolean"
          },
          "template": {
            "type": "boolean"
          }
        }
      },
      "SessionPage": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SessionSummary"
        }
      },
      "PortableManifest": {
        "type": "object",
        "required": [
          "format",
          "format_version",
          "title",
          "document",
          "checksum"
        ],
        "properties": {
          "format": {
            "const": "liberu.music.session"
          },
          "format_version": {
            "const": 1
          },
          "title": {
            "type": "string"
          },
          "document": {
            "$ref": "#/components/schemas/SessionDocument"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "ImportPreview": {
        "type": "object",
        "required": [
          "schema_version",
          "title",
          "document_schema_version",
          "checksum",
          "track_count",
          "asset_count",
          "module_names"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "title": {
            "type": "string"
          },
          "document_schema_version": {
            "const": 1
          },
          "checksum": {
            "type": "string"
          },
          "track_count": {
            "type": "integer"
          },
          "asset_count": {
            "type": "integer"
          },
          "module_names": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "schema_version",
          "document_schema_versions",
          "operations",
          "unsupported"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "document_schema_versions": {
            "const": [
              1
            ]
          },
          "operations": {
            "const": [
              "browse",
              "read",
              "history",
              "export",
              "import_preview"
            ]
          },
          "unsupported": {
            "const": [
              "write_commands",
              "revision_stream",
              "audio_execution",
              "remote_transport",
              "asset_transfer",
              "async_jobs"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "request_id",
          "errors"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "pointer",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "AssetReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "sample_rate",
          "channels",
          "frames"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sample_rate": {
            "type": "integer",
            "minimum": 8000,
            "maximum": 384000
          },
          "channels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "frames": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of sample frames, not samples per channel or seconds."
          }
        }
      },
      "Track": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "parent_id",
          "media_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "kind": {
            "enum": [
              "audio",
              "midi",
              "folder"
            ]
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "media_ids": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      },
      "ModuleState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "state"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": [
              "object",
              "array"
            ],
            "description": "Opaque state preserved for unavailable modules; no runtime compatibility implied."
          }
        }
      },
      "SessionSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace_id",
          "project_id",
          "title",
          "version",
          "checksum",
          "autosave",
          "template",
          "created_at"
        ],
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "autosave": {
            "type": "boolean"
          },
          "template": {
            "type": "boolean"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC revision timestamp; no sample-clock meaning."
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "The host that explicitly enables this module."
    }
  ]
}
