{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "music-projects-api",
  "display_name": "Music Projects API",
  "description": "Authorized Music session commands, metadata, portable imports and reconnectable revision polling.",
  "version": "0.1.0",
  "category": "presentation",
  "provider": "Liberu\\Music\\ProjectsApi\\MusicProjectsApiServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/music-projects": "^0.1 || dev-main"
    }
  },
  "capabilities": [
    "music.projects.api"
  ],
  "default_enabled": false,
  "features": [
    "Authorized session metadata queries",
    "Portable manifest import preview",
    "Conditional checkpoint and autosave commands",
    "Replay-safe historical recovery",
    "Confirmed portable imports",
    "Scoped encrypted revision cursors and explicit snapshot resynchronization"
  ]
}
